{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "part": {
      "type": "string",
      "enum": [
        "Foundations",
        "The Rule Set",
        "Surfaces",
        "Contracts",
        "Operations"
      ]
    },
    "folio": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "status": {
      "default": "settled",
      "type": "string",
      "enum": [
        "settled",
        "revising",
        "proposed"
      ]
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epigraph": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "part",
    "folio",
    "order"
  ]
}