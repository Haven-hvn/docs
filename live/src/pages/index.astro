---
import Base from '../layouts/Base.astro'
import Masthead from '../components/Masthead.astro'
import Footer from '../components/Footer.astro'
import Action from '../components/Action.astro'
import HeroAperture from '../components/react/HeroAperture.tsx'
import LiveInstrument from '../components/react/LiveInstrument.tsx'
import ledger from '../data/storage-ledger.json'
import {
  CLAIMS,
  HAVEN,
  HORIZON,
  LAYERS,
  MOVEMENTS,
  NETWORKS,
  SURFACES,
  TOPOLOGY,
} from '../lib/protocol.ts'
import { bytesInline, integer } from '../lib/format.ts'

const mainnet = ledger.mainnet
const calibration = ledger.calibration

const storage = {
  totalBytes: mainnet?.totalBytes ?? '0',
  liveDataSets: mainnet?.liveDataSets ?? 0,
  activeProviders: mainnet?.activeProviders ?? null,
  providerCount: mainnet?.providers.length ?? 0,
  usdfcEscrowed: mainnet?.usdfc.escrowed ?? '0',
  usdfcSupply: mainnet?.usdfc.supply ?? '0',
  usdfcDecimals: mainnet?.usdfc.decimals ?? 18,
  usdfcSymbol: mainnet?.usdfc.symbol ?? 'USDFC',
  blockNumber: mainnet?.blockNumber ?? '0',
  capturedAt: mainnet?.capturedAt ?? new Date().toISOString(),
}

const totalPinned = bytesInline(Number(mainnet?.totalBytes ?? 0) + Number(calibration?.totalBytes ?? 0))
const totalSets = (mainnet?.liveDataSets ?? 0) + (calibration?.liveDataSets ?? 0)
---

<Base
  title={HAVEN.name}
  description="Haven is an archive network for communities. Encrypted media on public infrastructure, with the key derived from what you hold — no accounts, no servers, no platform."
>
  <Masthead slot="masthead" current="record" />
  <Footer slot="footer" />

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 00 — THE APERTURE
      Void. One statement, one instrument, two ways in. Everything else on the
      page exists to substantiate the sentence in this act.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act hero" data-tone="void" aria-labelledby="hero-statement">
    <div class="stage hero-stage">
      <HeroAperture client:load label="Four public networks enclosing a protected void" />
    </div>

    <div class="act-body frame hero-body">
      <h1 class="statement-colossus hero-statement optical-hang" id="hero-statement">
        <span class="mask-line" data-reveal style="--delay: 60ms"><span>Ownership is the</span></span>
        <span class="mask-line" data-reveal style="--delay: 160ms"
          ><span>only password.</span></span
        >
      </h1>

      <div class="hero-columns">
        <p class="lede hero-lede" data-reveal style="--delay: 300ms">
          Haven keeps media encrypted on public infrastructure and derives the key to it from what a
          reader already holds. There is no account to open, no server to trust, and no platform
          standing between a community and its own archive.
        </p>

        <div class="hero-actions" data-reveal style="--delay: 400ms">
          <Action href="/docs/atlas" variant="sealed" size="large">Open the index</Action>
          <Action href="/docs/codex" variant="keyline" size="large" glyph="none">Read the docs</Action>
        </div>
      </div>
    </div>

    {/* Standing at the foot of the hero: the four networks, with the one that is
        not operational stated plainly rather than omitted. */}
    <div class="hero-foot frame" data-reveal style="--delay: 560ms">
      <dl class="hero-networks">
        {
          NETWORKS.map((network) => (
            <div class="hero-network" data-pending={network.id === 'arkiv' ? 'true' : undefined}>
              <dt class="hero-network-head">
                <span class:list={['net-dot', `net-${network.id}`]} aria-hidden="true" />
                <span class="hero-network-name">{network.name}</span>
              </dt>
              <dd class="hero-network-role">{network.role}</dd>
              <dd class="addr hero-network-id">{network.identifier}</dd>
              {network.id === 'arkiv' && <dd class="label hero-network-state">Index pending</dd>}
            </div>
          ))
        }
      </dl>
      <p class="label hero-scroll">
        <span>Scroll</span>
        <svg class="hero-scroll-rule" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M1.5 4.25L6 8.75L10.5 4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </p>
    </div>
  </section>

  {/* Sections change field colour outright: nothing fades into anything. */}

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 01 — THE PREMISE
      Stock. The argument, then five claims the rest of the document has to earn.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad-tall" data-tone="stock" aria-labelledby="premise-title">
    <div class="act-body frame">
      <div class="premise">
        <h2 class="editorial-headline premise-title" id="premise-title">
          <span class="mask-line" data-reveal><span>Every platform you have</span></span>
          <span class="mask-line" data-reveal style="--delay: 90ms"
            ><span>ever loved was a landlord.</span></span
          >
        </h2>

        <div class="premise-argument">
          <p class="prose-body" data-reveal style="--delay: 160ms">
            It held your work on its hardware, under its terms, for as long as its business model
            agreed with your existence. When the terms changed, the archive changed with them. Nothing
            about that arrangement was malicious. It was structural.
          </p>
          <p class="prose-body" data-reveal style="--delay: 220ms">
            Haven removes the structure rather than improving the landlord. Content is sealed before it
            is published, its index is a public state trie, its key is derived by a network rather than
            issued by a company, and the bill for keeping it is settled on-chain. What remains is a
            rule set — and a rule set has no offices to close.
          </p>
          <aside class="marginalia" data-reveal style="--delay: 280ms">
            <strong>{TOPOLOGY.services} services, {TOPOLOGY.privateDatastores} private datastores.</strong>{' '}
            Verified by a graph build over the workspace. There is no shared backend for any surface to
            depend on, which is why each one ships and fails alone.
          </aside>
        </div>
      </div>

      <ol class="claims">
        {
          CLAIMS.map((claim, index) => (
            <li class="claim" data-reveal style={`--delay: ${index * 70}ms`}>
              <h3 class="statement-title claim-label">{claim.label}</h3>
              <p class="claim-body">{claim.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 02 — THE MECHANISM
      Stock, dense. The layer table: what each network provides, and the single
      thing Haven adds on top of it.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad" data-tone="stock" aria-labelledby="mechanism-title">
    <div class="act-body frame">
      <div class="mechanism-intro">
        <h2 class="statement-display" id="mechanism-title" data-reveal>The layer above four chains.</h2>
        <p class="prose-body" data-reveal style="--delay: 120ms">
          Consensus, storage, settlement and threshold cryptography already exist, operated by networks
          that predate Haven and will outlast it. Haven specifies only how those four capabilities
          compose into one guarantee. The layers beneath see bytes, an <code>eth_call</code> and an
          <code>ecrecover</code> — they have no idea Haven exists, which is precisely why they cannot be
          leaned on to end it.
        </p>
      </div>

      <div class="layers" data-reveal>
        {
          LAYERS.map((layer) => (
            <article class="layer">
              <header class="layer-head">
                <h3 class="statement-title layer-title">{layer.title}</h3>
                <ul class="layer-nets" aria-label="Networks at this layer">
                  {layer.networks.map((id) => (
                    <li class:list={['net-dot', `net-${id}`]} title={id} />
                  ))}
                </ul>
              </header>
              <div class="layer-body">
                <div class="layer-cell">
                  <span class="label">Provided by</span>
                  <p class="layer-text">{layer.provider}</p>
                </div>
                <div class="layer-cell layer-cell-defines">
                  <span class="label label-seal">Haven defines</span>
                  <p class="layer-text">{layer.havenDefines}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <table class="specimen networks-table" data-reveal>
        <caption class="networks-caption">
          The four networks, their responsibilities, and where to verify them
        </caption>
        <thead>
          <tr>
            <th scope="col">Network</th>
            <th scope="col">Role</th>
            <th scope="col">Authoritative for</th>
            <th scope="col">Identifier</th>
            <th scope="col">Verify</th>
          </tr>
        </thead>
        <tbody>
          {
            NETWORKS.map((network) => (
              <tr data-pending={network.id === 'arkiv' ? 'true' : undefined}>
                <th scope="row" class="networks-name">
                  <span class:list={['net-dot', `net-${network.id}`]} aria-hidden="true" />
                  {network.name}
                </th>
                <td>{network.role}</td>
                <td class="networks-owns">{network.owns}</td>
                <td>
                  <span class="label networks-id-label">{network.identifierLabel}</span>
                  <span class="addr">{network.identifier}</span>
                </td>
                <td>
                  <a class="link-rule networks-link" href={network.explorer} rel="noreferrer noopener" target="_blank">
                    {network.id === 'arkiv' ? 'Node (503)' : 'Explorer'}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* Sections change field colour outright: nothing fades into anything. */}

  {/* ═══════════════════════════════════════════════════════════════════════
       ACT 03 — THE MOVEMENTS
       Void, pinned. Four beats, scrubbed by scroll: Encrypt, Register, Unlock, Open.
      The stage stays put while the argument advances through it.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act movements" data-tone="void" aria-labelledby="movements-title">
    <div class="movements-stage">
      <div class="act-body frame movements-inner">
        <div class="movements-side">
          <h2 class="statement-headline movements-title" id="movements-title">From disk to screen.</h2>

          <ol class="movements-index" aria-label="The four movements">
            {
              MOVEMENTS.map((movement) => (
                <li class="movements-index-item" data-index={movement.index - 1}>
                  <span class="movements-index-title">{movement.title}</span>
                  <span class="label movements-index-actor">{movement.actor}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="movements-beats">
          {
            MOVEMENTS.map((movement) => (
              <article class="movement">
                <h3 class="editorial-headline movement-claim">{movement.claim}</h3>
                <p class="movement-detail">{movement.detail}</p>

                <figure class="movement-evidence" data-ui>
                  <pre class="code-plate"><code>{movement.code}</code></pre>
                  <figcaption class="plate-caption">
                    <span>
                      Executed by {movement.actor} — {movement.primitive}. Nothing in this step requires a
                      service Haven operates.
                    </span>
                  </figcaption>
                </figure>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 04 — THE EVIDENCE
      Void. Claims are cheap; this act measures. Every figure is read live in the
      reader's browser, and the one network that is down says so.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad evidence-act" data-tone="void" aria-labelledby="evidence-title">
    <div class="act-body frame">
      <div class="evidence-head">
        <h2 class="statement-display" id="evidence-title" data-reveal>Read the networks, live.</h2>
        <p class="prose-body" data-reveal style="--delay: 120ms">
          A page that animates invented activity is easy to build and worth nothing. Every figure below
          is a real round-trip from your browser to a public endpoint, with no key and no proxy —
          including the one that fails. Storage is aggregated from the Filecoin pin contracts on FEVM;
          across both deployments that is <strong>{totalPinned}</strong> under proof in{' '}
          {integer(totalSets)} live data sets.
        </p>
      </div>

      <div class="evidence-panel panel-sunk" data-ui data-reveal style="--delay: 200ms">
        <LiveInstrument client:visible storage={storage} />
      </div>
    </div>
  </section>

  {/* Sections change field colour outright: nothing fades into anything. */}

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 05 — THE SURFACES
      Stock. Five independent clients, five languages, no shared code.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad" data-tone="stock" aria-labelledby="surfaces-title">
    <div class="act-body frame">
      <div class="surfaces-head">
        <h2 class="statement-display" id="surfaces-title" data-reveal>
          Five clients that have never met.
        </h2>
        <p class="prose-body" data-reveal style="--delay: 120ms">
          Each surface is written in a different language, ships on its own schedule, and shares no
          database, queue or library with the others. They agree because they obey the same rule set —
          not because they import the same code. That is the difference between a protocol and a
          monolith with several front ends.
        </p>
      </div>

      <div class="surfaces" data-reveal>
        {
          SURFACES.map((surface) => (
            <article class="surface">
              <header class="surface-head">
                <h3 class="surface-name">{surface.name}</h3>
                <span class="label surface-language">{surface.language}</span>
              </header>

              <div class="surface-body">
                <p class="surface-role">{surface.role}</p>

                <dl class="surface-facts">
                  <div>
                    <dt class="label">Owns</dt>
                    <dd>{surface.owns}</dd>
                  </div>
                  <div>
                    <dt class="label">Does not own</dt>
                    <dd class="surface-not">{surface.doesNotOwn}</dd>
                  </div>
                </dl>

                <footer class="surface-foot">
                  <code class="addr">{surface.artifact}</code>
                  <ul class="surface-nets" aria-label="Networks this surface talks to">
                    {surface.talksTo.map((id) => (
                      <li class:list={['net-dot', `net-${id}`]} title={id} />
                    ))}
                  </ul>
                </footer>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Sections change field colour outright: nothing fades into anything. */}

  {/* ═══════════════════════════════════════════════════════════════════════
       ACT 06 — THE INDEX
       Void. The invitation. Two axes, stated honestly, then the door.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad-tall atlas-invite" data-tone="void" aria-labelledby="atlas-title">
    <div class="act-body frame">
      <div class="atlas-invite-grid">
        <div class="atlas-invite-copy">
          <h2 class="editorial-display" id="atlas-title" data-reveal>Every community is a world.</h2>
          <p class="lede" data-reveal style="--delay: 140ms">
            The index draws the archive as a system of bodies in motion: real communities, real
            balances, real storage under proof. Two measures, kept deliberately apart — how much a
            world keeps, and what a world is worth.
          </p>

          <dl class="atlas-axes" data-reveal style="--delay: 220ms">
            <div class="atlas-axis">
              <dt class="label">Storage</dt>
              <dd>
                What a community has pinned under proof, summed over the addresses that paid for it —
                leaf counts, live data sets, and the {storage.usdfcSymbol} escrowed to keep them, read
                from the Filecoin pin contracts on FEVM. Not what a provider holds: providers supply
                the capacity, they do not publish the archive.
              </dd>
            </div>
            <div class="atlas-axis">
              <dt class="label">Capitalisation</dt>
              <dd>
                What the key asset is worth. Supply comes from the contract; price comes from the
                market, because price is not an on-chain fact.
              </dd>
            </div>
            <div class="atlas-axis atlas-axis-pending">
              <dt class="label">Attribution, pending</dt>
              <dd>
                Every byte above is a real on-chain sum. Which community each uploading address
                publishes for is not on Filecoin at all — it is metadata, and metadata is Arkiv's job.
                Until its index answers, that one hop is a documented placeholder and the edges that
                depend on it are drawn unlit rather than guessed.
              </dd>
            </div>
          </dl>

          <div class="atlas-invite-action" data-reveal style="--delay: 300ms">
            <Action href="/docs/atlas" variant="sealed" size="large">Open the index</Action>
            <Action href="/docs/threshold" variant="keyline" glyph="none">Check an address</Action>
          </div>
        </div>

        <figure class="atlas-invite-plate" data-reveal style="--delay: 200ms">
          <div class="atlas-invite-visual" aria-hidden="true">
            <div class="orbit orbit-1"></div>
            <div class="orbit orbit-2"></div>
            <div class="orbit orbit-3"></div>
            <div class="orbit-core"></div>
          </div>
          <figcaption class="plate-caption">
            <span>
              The observatory inverts the document: in the index the network is the only light source.
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* Sections change field colour outright: nothing fades into anything. */}

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 07 — THE HORIZON
      Stock, editorial. The argument for the future, set in the serif.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act act-pad-tall" data-tone="stock" aria-labelledby="horizon-title">
    <div class="act-body frame">
      <blockquote class="manifesto" data-reveal>
        <p class="manifesto-text" id="horizon-title">
          The question is not whether a community can publish — it is whether, in thirty years, anyone
          still can.
        </p>
      </blockquote>

      <ol class="horizon">
        {
          HORIZON.map((phase, index) => (
            <li class="phase" data-state={phase.state} data-reveal style={`--delay: ${index * 80}ms`}>
              <div class="phase-body">
                <header class="phase-head">
                  <h3 class="statement-title phase-title">{phase.title}</h3>
                  <span class="label phase-state">
                    {phase.state === 'live'
                      ? 'Standing'
                      : phase.state === 'active'
                        ? 'Underway'
                        : phase.state === 'next'
                          ? 'Next'
                          : 'Horizon'}
                  </span>
                </header>
                <p class="phase-text">{phase.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
      ACT 08 — THE CLOSE
      Void. One sentence, monumental, and the door.
      ═══════════════════════════════════════════════════════════════════════ */}
  <section class="act close" data-tone="void" aria-labelledby="close-title">
    <div class="act-body frame close-body">
      <h2 class="statement-monument close-title optical-hang" id="close-title">
        <span class="mask-line" data-reveal><span>Nothing to</span></span>
        <span class="mask-line" data-reveal style="--delay: 90ms"><span>shut down.</span></span>
      </h2>
      <div class="close-actions" data-reveal style="--delay: 220ms">
        <Action href="/docs/threshold" variant="sealed" size="large">Check if you qualify</Action>
        <Action href="/docs/atlas" variant="keyline" size="large" glyph="none">Open the index</Action>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     ACT 00 — HERO
     ══════════════════════════════════════════════════════════════════════════ */
  .hero {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: calc(100dvh - var(--chrome-h));
    padding-top: clamp(3rem, 2rem + 5vw, 8rem);
    overflow: clip;
  }

  .hero-stage {
    /* The instrument is centred on the void, biased right so the type has the
       left two-thirds of the sheet to itself. */
    inset-inline-start: auto;
    inset-inline-end: -8%;
    width: min(78vw, 62rem);
    aspect-ratio: 1;
    top: 50%;
    translate: 0 -55%;
    opacity: 0.95;
  }

  .hero-body {
    align-self: center;
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.6vw, 2.75rem);
    max-width: min(100%, 92rem);
  }

  /* `ch` here is relative to the colossus size, which is the intent: about
     fourteen characters per line at any viewport. */
  .hero-statement {
    max-width: 14ch;
  }

  .hero-columns {
    display: grid;
    grid-template-columns: minmax(0, 34rem) auto;
    align-items: end;
    gap: clamp(2rem, 1rem + 3vw, 5rem);
  }

  .hero-lede {
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Standing foot: the four networks ─────────────────────────────────── */
  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }

  .hero-networks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
  }

  .hero-network {
    display: grid;
    gap: 0.35rem;
    padding-inline: clamp(0.75rem, 1.4vw, 1.75rem);
  }

  .hero-network:first-child {
    padding-left: 0;
  }

  .hero-network-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero-network-name {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--fg);
    letter-spacing: -0.014em;
  }

  .hero-network-role,
  .hero-network-id,
  .hero-network-state {
    margin: 0;
  }

  .hero-network-role {
    font-size: var(--text-fine);
    color: var(--fg-3);
  }

  .hero-network-id {
    font-size: 0.8125rem;
    color: var(--fg-4);
    overflow-wrap: anywhere;
  }

  .hero-network-state {
    color: var(--seal-text);
  }

  /* The pending network is dimmed but never removed. */
  .hero-network[data-pending] .hero-network-name {
    color: var(--fg-3);
  }

  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--fg-4);
  }

  .hero-scroll-rule {
    color: var(--fg-2);
    animation: scroll-hint 2.8s var(--ease-in-out-quint) infinite;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: translateY(-2px);
      opacity: 0.4;
    }
    50% {
      transform: translateY(2px);
      opacity: 1;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     ACT 01 — PREMISE
     ══════════════════════════════════════════════════════════════════════════ */
  .premise {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 7rem);
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .premise-title {
    max-width: 26ch;
  }

  .premise-argument {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding-top: 0.5rem;
  }

  .claims {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    list-style: none;
  }

  .claim {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    min-height: 12rem;
  }

